<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Must match the namespace verified on Maven Central (the configstream GitHub organisation) -->
    <groupId>io.github.configstream</groupId>
    <artifactId>configstream-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>configstream</name>
    <description>Push-based, restart-free feature flags and config for Spring Boot, using your database's native change notifications.</description>
    <url>https://github.com/configstream/configstream</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <!-- developers + scm are required POM metadata for Maven Central -->
    <developers>
        <developer>
            <id>khaja-mohammed-dev</id>
            <name>Khaja Mohammed</name>
            <url>https://github.com/khaja-mohammed-dev</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/configstream/configstream</url>
        <connection>scm:git:https://github.com/configstream/configstream.git</connection>
        <developerConnection>scm:git:https://github.com/configstream/configstream.git</developerConnection>
    </scm>

    <modules>
        <module>configstream-api</module>
        <!-- Build-time: generates typed property constants from configstream.yml -->
        <module>configstream-processor</module>
        <module>configstream-mongo</module>
        <module>configstream-spring-boot-starter</module>
        <!-- Admin server as a starter: add it to any Spring Boot app, plus @EnableConfigStreamAdminServer -->
        <module>configstream-admin-spring-boot-starter</module>
        <!-- configstream-postgres will be added here in v2 -->
        <!-- Runnable sample apps for local testing; not published -->
        <module>samples/demo-admin</module>
        <module>samples/demo-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.5.0</spring-boot.version>
        <testcontainers.version>1.21.4</testcontainers.version>

        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM imported (not used as parent) so consumers aren't forced onto our parent POM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>configstream-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>configstream-mongo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <!-- Integration tests (*IT.java) run in 'verify' phase, e.g. Testcontainers tests -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Publishing to Maven Central: mvn -P release deploy
          Needs the Central Portal token in ~/.m2/settings.xml (server id "central") and the GPG key's passphrase in
          the MAVEN_GPG_PASSPHRASE environment variable. Uploads are left for review in the portal, not published
          automatically: check them under Deployments, then click Publish.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <release>${java.version}</release>
                            <!-- Don't fail the release on Javadoc style warnings -->
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <configuration>
                            <!-- Reads the passphrase from MAVEN_GPG_PASSPHRASE, never from a file -->
                            <bestPractices>true</bestPractices>
                            <keyname>592FB5FE99CC80BD</keyname>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Review the upload in the portal before it goes public: releases can't be deleted -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- The sample apps are for trying configstream locally, not for publishing -->
                            <excludeArtifacts>
                                <artifact>demo-admin</artifact>
                                <artifact>demo-service</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
